# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 파이프라인 수집 결과 (데이터는 DB에만 둔다)
/pipeline/.out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 쉼터 로컬 DB
/server/*.db

# 브레인스토밍 시안 도구 작업 파일 (서버 상태, 시안 HTML)
/.superpowers/

# Playwright 산출물. 기준 화면은 로컬 전용이다.
/test-results/
/playwright-report/
/blob-report/
/e2e/__screenshots__/
